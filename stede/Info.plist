<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Die App nutzt nur HTTPS über URLSession, also ausschließlich die
	     Verschlüsselung des Betriebssystems. Damit entfällt die
	     Ausfuhr-Frage bei jedem Upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
